# Copy to .env and adjust. Never commit .env.
# Rotated credentials (P0) — replace in each environment.

# Local PostgreSQL (default 5432). Docker compose used 5434 — prefer local for day-to-day.
DB_URL=jdbc:postgresql://127.0.0.1:5432/smart_community
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

POSTGRES_DB=smart_community
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

JWT_SECRET=HavenJwt_Rot_2026_v1_9f3c7a2e8b4d1c6e5a0f7b2d4e8c1a3f
JWT_EXPIRATION_MINUTES=480

# Used by DemoDataSeeder for local demo accounts (not a production secret store)
DEMO_PASSWORD=HavenDemo!2026Rotate

# --- SMTP (required for real OTP email delivery) ---
SMTP_ENABLED=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com
SMTP_FROM_NAME=Haven
SMTP_STARTTLS=true
SMTP_SSL=false

# Login OTP
OTP_TTL_MINUTES=10
# Keep false when SMTP is working. true only for local API testing without inbox.
OTP_EXPOSE=false

# --- Google Sign-In (optional) ---
# Create OAuth 2.0 Client IDs in Google Cloud Console (Web + Android + iOS as needed).
# Users must already exist in Haven (same rule as OTP) — Google does not auto-create accounts.
GOOGLE_ENABLED=false
GOOGLE_CLIENT_IDS=
# Frontend / Expo (public client IDs only — never put secrets here)
# VITE_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
