{
  "info": {
    "_postman_id": "a7c3e9f1-2b4d-4e8a-9c1f-6d5e0b8a2f31",
    "name": "Haven AMS — Smart Community API",
    "description": "Apartment Management System API (`/api/v1`).\n\n**Auth (email + OTP via SMTP)**\n1. Set `SMTP_*` in server `.env` and `SMTP_ENABLED=true`\n2. Request OTP → code arrives in the mailbox\n3. Login with `{ email, otp }`\n\nIf SMTP is off and `OTP_EXPOSE=true`, Request OTP also returns `devOtp` for local testing.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8080/api/v1" },
    { "key": "token", "value": "" },
    { "key": "otp", "value": "" },
    { "key": "loginEmail", "value": "admin@haven.local" },
    { "key": "apartmentId", "value": "" },
    { "key": "blockId", "value": "" },
    { "key": "floorId", "value": "" },
    { "key": "flatId", "value": "" },
    { "key": "residentId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "billId", "value": "" },
    { "key": "visitorId", "value": "" },
    { "key": "qrToken", "value": "" },
    { "key": "parkingSlotId", "value": "" },
    { "key": "complaintId", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Request OTP (Super Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('OTP requested', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('loginEmail', 'superadmin@haven.local');",
                  "if (data.devOtp) pm.collectionVariables.set('otp', data.devOtp);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"superadmin@haven.local\"\n}"
            },
            "url": "{{baseUrl}}/auth/otp/request",
            "description": "Returns `devOtp` when OTP_EXPOSE=true (local)."
          }
        },
        {
          "name": "Login (Super Admin)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Login OK', () => pm.response.to.have.status(200));",
                  "const data = pm.response.json();",
                  "pm.collectionVariables.set('token', data.accessToken);",
                  "if (data.user && data.user.apartmentId) pm.collectionVariables.set('apartmentId', data.user.apartmentId);"
                ],
                "type": "text/javascript"
