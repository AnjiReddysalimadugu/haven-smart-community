# Copy to .env for local Expo (or set in shell before `npm start`)
# Phone cannot use localhost — use your PC LAN IP.
EXPO_PUBLIC_API_URL=http://192.168.1.10:8080/api/v1

# From `eas init` / https://expo.dev — leave empty until configured
EXPO_PUBLIC_EAS_PROJECT_ID=

# Optional UPI collect defaults
EXPO_PUBLIC_UPI_VPA=haven@upi
EXPO_PUBLIC_UPI_PAYEE=Haven Society

# Google Sign-In (OAuth client IDs from Google Cloud Console — public IDs only)
# Also set GOOGLE_ENABLED=true and GOOGLE_CLIENT_IDS on the API (.env)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
